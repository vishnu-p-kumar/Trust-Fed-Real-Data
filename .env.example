OPENWEATHER_API_KEY=
SMARTGRID_UPDATE_INTERVAL=4
SMARTGRID_FULL_SCALE=0
SMARTGRID_DEMO_MODE=0
SMARTGRID_ENABLE_ALERTS=0
SMARTGRID_COOKIE_SECURE=0
SMARTGRID_ADMIN_EMAIL=admin@gmail.com
SMARTGRID_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_RANDOM_PASSWORD
SMARTGRID_SESSION_SECRET=replace-with-at-least-32-random-characters
SMARTGRID_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8080,http://localhost:8080
SMARTGRID_TELEGRAM_BOT_TOKEN=
SMARTGRID_TELEGRAM_CHAT_ID=
SMARTGRID_SMTP_HOST=
SMARTGRID_SMTP_PORT=587
SMARTGRID_SMTP_USER=
SMARTGRID_SMTP_PASSWORD=
SMARTGRID_ALERT_EMAIL_FROM=
SMARTGRID_ALERT_EMAIL_TO=

TRUSTFED_DB_PATH=database/trustfed_phase2.sqlite3

# Differential privacy for federated coordinator aggregation (enabled in production compose)
TRUSTFED_DP_ENABLED=1
TRUSTFED_DP_CLIP_NORM=5.0
TRUSTFED_DP_NOISE_MULTIPLIER=1.5
TRUSTFED_DP_DELTA=1e-5
TRUSTFED_DP_MAX_EPSILON=10.0

# Optional PostgreSQL/Redis worker adapters
POSTGRES_PASSWORD=change-this-to-a-long-random-secret
SMARTGRID_POSTGRES_DSN=postgresql://trustfed:change-this-to-a-long-random-secret@localhost:5432/trustfed
REDIS_URL=redis://localhost:6379/0


# Default runtime: SGCC-trained live classifier + incoming meter telemetry.
# Set SMARTGRID_DEMO_MODE=1 only to run the optional synthetic replay demo.
SMARTGRID_SGCC_TARGET_RECALL=0.40
SMARTGRID_SGCC_WINDOWS_PER_CUSTOMER=1
